<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationIcon>Assets\WorkBlock.ico</ApplicationIcon>
    <AssemblyTitle>WorkBlock</AssemblyTitle>
    <Product>WorkBlock</Product>
    <Description>WorkBlock focus timer for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\WorkBlock.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

</Project>
