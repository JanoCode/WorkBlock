<Window x:Class="WorkBlock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkBlock"
        Icon="Assets/WorkBlock.ico"
        Width="360"
        Height="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- BOTÓN NORMAL -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D7F3EE"/>
            <Setter Property="Background" Value="#092A28"/>
            <Setter Property="BorderBrush" Value="#24514C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EFFFFC"/>
            <Setter Property="Background" Value="#27675D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- BOTONES 30 / 45 / 60 -->
        <Style x:Key="TimeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B9D3CF"/>
            <Setter Property="Background" Value="#0A2C29"/>
            <Setter Property="BorderBrush" Value="#24514C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <!-- VENTANA PRINCIPAL -->
    <Border
        CornerRadius="14"
        BorderThickness="1"
        BorderBrush="#335C58"
        Background="#E60A2422">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- BARRA SUPERIOR -->
            <Border
                Grid.Row="0"
                Background="#C8123733"
                CornerRadius="14,14,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid Margin="14,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock
                        Text="◉  WorkBlock"
                        Foreground="#CDE9E5"
                        FontWeight="SemiBold"
                        FontSize="12"
                        VerticalAlignment="Center"/>


                    <!-- PIN -->
                    <Button
                        x:Name="PinButton"
                        Grid.Column="1"
                        Content="📌"
                        Width="32"
                        Height="30"
                        Foreground="#B7D8D2"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="PinButton_Click"/>


                    <!-- MINIMIZAR -->
                    <Button
                        Grid.Column="2"
                        Content="−"
                        Width="32"
                        Height="30"
                        Foreground="#B7D8D2"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="17"
                        Cursor="Hand"
                        Click="MinimizeButton_Click"/>


                    <!-- CERRAR -->
                    <Button
                        Grid.Column="3"
                        Content="×"
                        Width="32"
                        Height="30"
                        Foreground="#B7D8D2"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="17"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>

                </Grid>
            </Border>


            <!-- CONTENIDO -->
            <Grid Grid.Row="1" Margin="25">

                <StackPanel VerticalAlignment="Center">


                    <!-- ESTADO -->
                    <Border
                        Background="#123A35"
                        BorderBrush="#24594F"
                        BorderThickness="1"
                        CornerRadius="15"
                        HorizontalAlignment="Center"
                        Padding="12,5"
                        Margin="0,0,0,28">

                        <TextBlock
                            x:Name="ModeIndicator"
                            Text="●  TRABAJO"
                            Foreground="#92E2D2"
                            FontSize="11"
                            FontWeight="SemiBold"/>

                    </Border>


                    <!-- TIMER -->
                    <TextBlock
                        x:Name="TimerText"
                        Text="30:00"
                        Foreground="#E9FFFB"
                        FontSize="66"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20"/>


                    <!-- TIEMPOS -->
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,38">

                        <Button
                            Content="30 min"
                            Style="{StaticResource TimeButton}"
                            Click="Button30_Click"/>

                        <Button
                            Content="45 min"
                            Style="{StaticResource TimeButton}"
                            Click="Button45_Click"/>

                        <Button
                            Content="60 min"
                            Style="{StaticResource TimeButton}"
                            Click="Button60_Click"/>

                    </StackPanel>


                    <!-- INICIAR -->
                    <Button
                        x:Name="StartButton"
                        Content="▶  Iniciar"
                        Height="52"
                        Margin="0,0,0,12"
                        Style="{StaticResource PrimaryButton}"
                        Click="StartButton_Click"/>


                    <!-- PAUSAR / REINICIAR -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <Button
                            Grid.Column="0"
                            Content="Ⅱ  Pausar"
                            Height="42"
                            Style="{StaticResource SecondaryButton}"
                            Click="PauseButton_Click"/>


                        <Button
                            Grid.Column="2"
                            Content="↻  Reiniciar"
                            Height="42"
                            Style="{StaticResource SecondaryButton}"
                            Click="ResetButton_Click"/>

                    </Grid>

                    <Button
                        x:Name="SkipBreakButton"
                        Content="Omitir descanso"
                        Height="42"
                        Margin="0,12,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="SkipBreakButton_Click"
                        Visibility="Collapsed"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>
