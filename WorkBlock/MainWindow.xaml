<Window x:Class="WorkBlock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkBlock"
        Height="500"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <StackPanel VerticalAlignment="Center">

            <TextBlock
                Text="WORKBLOCK"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,30"/>

            <TextBlock
                x:Name="TimerText"
                Text="30:00"
                FontSize="64"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,40"/>

            <TextBlock
                Text="Duración del bloque"
                FontSize="16"
                HorizontalAlignment="Center"
                Margin="0,0,0,15"/>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Button
                    Content="30 MIN"
                    Width="90"
                    Height="40"
                    Margin="5"
                    Click="Button30_Click"/>

                <Button
                    Content="45 MIN"
                    Width="90"
                    Height="40"
                    Margin="5"
                    Click="Button45_Click"/>

                <Button
                    Content="60 MIN"
                    Width="90"
                    Height="40"
                    Margin="5"
                    Click="Button60_Click"/>

            </StackPanel>

            <Button
                x:Name="StartButton"
                Content="INICIAR"
                Height="50"
                Margin="5,30,5,0"
                FontSize="18"
                Click="StartButton_Click"/>

        </StackPanel>

    </Grid>

</Window>